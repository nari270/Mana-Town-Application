{
  "expo": {
    "name": "ManaTown Digital",
    "slug": "mana-town-digital",
    "scheme": "manatown",
    "version": "1.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-router",
      "expo-updates",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ManaTown uses your location to suggest nearby businesses."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ManaTown uses the camera only when you choose to add a business photo.",
          "photosPermission": "ManaTown accesses photos only when you choose a business photo."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "android": {
      "package": "in.manatown.digital"
    },
    "web": {
      "bundler": "metro"
    }
  }
}
