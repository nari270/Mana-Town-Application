NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mana_town?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/mana_town?schema=public
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace-with-project-key
# Server only. Never expose this key to the client.
SUPABASE_SECRET_KEY=sb_secret_replace-with-server-key
# Also used as the signup email confirmation redirect (first origin if comma-separated).
CLIENT_ORIGIN=http://localhost:8081
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
# Demo accounts (admin, owner, resident, entrepreneur). Never enable in production.
SEED_DEMO_DATA=true
SEED_PASSWORD_ADMIN=replace-with-12-or-more-characters
SEED_PASSWORD_OWNER=replace-with-12-or-more-characters
SEED_PASSWORD_RESIDENT=replace-with-12-or-more-characters
SEED_PASSWORD_ENTREPRENEUR=replace-with-12-or-more-characters
# One-time data migration only: the existing Neon source and Supabase target.
NEON_DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/database?sslmode=require
SUPABASE_DIRECT_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.your-project-ref.supabase.co:5432/postgres?sslmode=require
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mana-town-local
S3_ACCESS_KEY_ID=local-development-only
S3_SECRET_ACCESS_KEY=local-development-only
S3_FORCE_PATH_STYLE=true
